# Copy to .env (git-ignored). spring-boot:run and the tests read it from the working directory.

# Any Base64 string of at least 64 bytes, e.g. `openssl rand -base64 64 | tr -d '\n'`.
JWT_SECRET_KEY=

# OpenAI-compatible chat completions endpoint. The bot was developed against
# OpenRouter with meta-llama/llama-3.3-70b-instruct.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_API_KEY=

# Vezilka Public Donation API v1 key (sent as X-Donation-Api-Key). Issued by the course.
VEZILKA_API_KEY=
